# {{ ansible_managed }}
# Read before 20-hardening.conf: on a conflict, the CIS value wins.
{% if cis_ssh_allow_users | length > 0 %}
AllowUsers {{ cis_ssh_allow_users | join(' ') }}
{% endif %}
Ciphers {{ cis_ssh_ciphers | join(',') }}
KexAlgorithms {{ cis_ssh_kex_algorithms | join(',') }}
MACs {{ cis_ssh_macs | join(',') }}
HostbasedAuthentication {{ cis_ssh_hostbased_authentication }}
IgnoreRhosts {{ cis_ssh_ignore_rhosts }}
LoginGraceTime {{ cis_ssh_login_grace_time }}
LogLevel {{ cis_ssh_log_level }}
MaxSessions {{ cis_ssh_max_sessions }}
MaxStartups {{ cis_ssh_max_startups }}
PermitEmptyPasswords {{ cis_ssh_permit_empty_passwords }}
PermitUserEnvironment {{ cis_ssh_permit_user_environment }}
